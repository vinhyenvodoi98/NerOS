PRIVATE_KEY=              # deployer + agent signer
RPC_URL=                  # Sepolia RPC (Alchemy/Infura)
ZERO_G_PROVIDER_ADDRESS=  # 0G Compute provider address (from broker.inference.listService())
ZERO_G_RPC=               # 0G storage node endpoint
ZERO_G_PRIVATE_KEY=       # 0G storage signer
ENS_NAME=                 # ENS name owned by the agent wallet (e.g. nerosbot.eth)
ENS_RESOLVER=             # ENS PublicResolver on Sepolia (unused — resolved dynamically)
UNISWAP_ROUTER=           # SwapRouter02 on Sepolia
KEEPERHUB_REGISTRY=       # KeeperHub registry address
ETHERSCAN_API_KEY=        # contract verification
MAINNET_RPC_URL=          # Optional: Only if you want to deploy to Mannet RPC
